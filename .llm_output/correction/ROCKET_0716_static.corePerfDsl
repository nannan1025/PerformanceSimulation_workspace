//generate by gpt using info from rtl ---change 0424 version
//date:0716
//version 02
/***** Microaction Section *****/

Connector {Pc, Pc_np, Pc_p}
Connector {Ic_out, Ic_in}
Connector {Xa, Xb, Xd}

Resource {PC_Gen, BPU, ITLB, Decoder, ALU, Branch, DTLB, CSR, Reg, LSUReq, LoadWB, StoreCommit}
Resource {ICache(iCacheModel), DCache(dCacheModel)}
Resource {MUL, DIV(divider), DIVU(divider_u)}
Resource {FlushMem, FlushWb}
Resource {EXPass, MEMPass, WBPass}

Microaction {
  uA_PCGen          (Pc -> PC_Gen -> Pc_p),
  uA_CacheBlock     (Ic_out),
  uA_ITLB           (ITLB),
  uA_IFetch         (ICache -> Ic_in),


  uA_Decode         (Decoder),
  uA_OF_A           (Xa),
  uA_OF_B           (Xb),

  uA_ALU_arith      (ALU -> Xd),
  uA_ALU_branch     (ALU), 
  uA_ALU_addr       (ALU),
  uA_DTLB           (DTLB),
  uA_LSUReq         (LSUReq),
  uA_DCachePipe     (DCache),
  uA_LoadWriteBack  (LoadWB -> Xd),
  uA_StoreCommit    (StoreCommit),

  uA_CSRRetire      (CSR -> Xd),
  uA_MUL            (MUL -> Xd),
  uA_DIV            (DIV -> Xd),
  uA_DIVU           (DIVU -> Xd),

  uA_FlushMem       (FlushMem),
  uA_FlushWb        (FlushWb),
  uA_EXPass         (EXPass),
  uA_MEMPass        (MEMPass),
  uA_WBPass         (WBPass),

  uA_BranchResolve  (Branch -> Pc_np),
  uA_JumpResolve    (Branch -> Pc_np),
  uA_JumpRegResolve (Xa -> Branch -> Pc_np),
  uA_RegWriteBack   (Reg)
}


/***** Stages & Pipeline *****/

Stage {
  IF    (uA_PCGen, uA_CacheBlock, uA_ITLB, uA_IFetch),
  ID    (uA_Decode, uA_OF_A, uA_OF_B),
  EX    (uA_ALU_arith, uA_ALU_branch, uA_ALU_addr, uA_MUL, uA_DIV, uA_DIVU, uA_DTLB, uA_LSUReq, uA_EXPass),
  MEM   (uA_DCachePipe, uA_StoreCommit, uA_FlushMem, uA_MEMPass),
  WB    (uA_JumpResolve, uA_JumpRegResolve, uA_BranchResolve, uA_LoadWriteBack, uA_CSRRetire, uA_FlushWb, uA_RegWriteBack, uA_WBPass)
}

Pipeline RC_pipeline (IF -> ID -> EX -> MEM -> WB)

/***** External Models *****/
TraceValue {rs1, rs2, rd, pc, brTarget, imm, rs1_data, rs2_data, addr}


ConnectorModel staBranchPredModel (
  link : "models/common/StaticBranchPredictModel.h"
  trace : {pc, brTarget}
  connectorIn : {Pc_np, Pc_p}
  connectorOut : Pc
)


Model iCacheModel (
  link : "models/rocket/ICacheModel.h"
  trace : {pc}
  connectorIn : {Ic_in}
  connectorOut : {Ic_out}
)

ConnectorModel regModel (
  link : "models/common/StandardRegisterModel.h"
  trace : {rs1, rs2, rd}
  connectorIn : Xd
  connectorOut : {Xa, Xb}
)


ResourceModel divider (
  link : "models/rocket/DividerModel.h"
  trace : {rs1_data, rs2_data}
)

ResourceModel divider_u (
  link : "models/rocket/DividerUnsignedModel.h"
  trace : {rs1_data, rs2_data}
)



Model dCacheModel (
  link : "models/rocket/DCacheModel.h"
  trace : {addr}
)

/***** Instruction Section *****/
InstrGroup {
  Arith_Ra_Rb (add, sub, xor, or, and, slt, sltu, sll, srl, sra, addw, subw),
  Arith_Ra (addi, xori, ori, andi, slti, sltiu, slli, srli, srai, addiw, slliw, sraiw, srliw),
  Arith_X (auipc, lui),

  Mul_Ra_Rb (mul, mulw),
  MulH_Ra_Rb (mulh, mulhu, mulhsu),
  Div_Ra_Rb (div, rem, divw, remw),
  DivU_Ra_Rb (divu, remu, divuw, remuw),

  Csr_Ra (csrrw, csrrs, csrrc),
  Csr_X (csrrwi, csrrsi, csrrci),

  Store (sb, sh, sw, sd),
  Load (lb, lbu, lh, lhu, lw, ld, lwu),

  Branch_Ra_Rb (beq, bne, blt, bge, bltu, bgeu),
  Jump (jal),
  JumpR (jalr),

  Default ([?])
}

MicroactionMapping {
  [ALL] :        {uA_PCGen, uA_CacheBlock, uA_ITLB, uA_IFetch, uA_Decode},

  Arith_Ra_Rb :  {uA_OF_A, uA_OF_B, uA_ALU_arith, uA_MEMPass, uA_RegWriteBack},
  Arith_Ra :     {uA_OF_A, uA_ALU_arith, uA_MEMPass, uA_RegWriteBack},
  Arith_X :      {uA_ALU_arith, uA_MEMPass, uA_RegWriteBack},

  Mul_Ra_Rb :    {uA_OF_A, uA_OF_B, uA_MUL, uA_MEMPass, uA_RegWriteBack},
  MulH_Ra_Rb :   {uA_OF_A, uA_OF_B, uA_MUL, uA_MEMPass, uA_RegWriteBack},
  Div_Ra_Rb :    {uA_OF_A, uA_OF_B, uA_DIV, uA_MEMPass, uA_RegWriteBack},
  DivU_Ra_Rb :   {uA_OF_A, uA_OF_B, uA_DIVU, uA_MEMPass, uA_RegWriteBack},

  Csr_Ra :       {uA_OF_A, uA_EXPass, uA_MEMPass, uA_CSRRetire, uA_RegWriteBack},
  Csr_X :        {uA_EXPass, uA_MEMPass, uA_CSRRetire, uA_RegWriteBack},

  Load :         {uA_OF_A, uA_ALU_addr, uA_DTLB, uA_LSUReq, uA_DCachePipe, uA_LoadWriteBack, uA_RegWriteBack},
  Store :        {uA_OF_A, uA_OF_B, uA_ALU_addr, uA_DTLB, uA_LSUReq, uA_DCachePipe, uA_StoreCommit, uA_WBPass},

  Branch_Ra_Rb : {uA_OF_A, uA_OF_B, uA_ALU_branch, uA_MEMPass, uA_BranchResolve},
  Jump :         {uA_ALU_arith, uA_MEMPass,  uA_JumpResolve},
  JumpR :        {uA_OF_A, uA_ALU_arith, uA_MEMPass, uA_JumpRegResolve},

  Default :      {uA_EXPass, uA_MEMPass, uA_WBPass}

}

TraceValueMapping {
  [ALL] : {
    pc = "$resolved{$pc}"
  },

  Arith_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },

  Arith_Ra : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },

  Arith_X : {
    rd  = "$bitfield{rd}"
  },

  Mul_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },

  MulH_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },

  Div_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}",
    rs1_data = "$reg{$bitfield{rs1}}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },

  DivU_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}",
    rs1_data = "$reg{$bitfield{rs1}}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },

  Csr_Ra : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },

  Csr_X : {
    rd  = "$bitfield{rd}"
  },

  Store : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    addr = "($reg{$bitfield{rs1}} + $bitfield{imm})"
  },

  Load : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}",
    addr = "($reg{$bitfield{rs1}} + $bitfield{imm})"
  },

  Branch_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    brTarget = "$resolved{$pc + (((int16_t)($bitfield{imm} << 3)) >> 3)}",
    imm = "$resolved{(((int16_t)($bitfield{imm} << 3)) >> 3)}"
  },

  Jump : {
    rd = "$bitfield{rd}",
    brTarget = "$resolved{$pc + (((int32_t)($bitfield{imm} << 11)) >> 11)}",
    imm = "$resolved{(((int32_t)($bitfield{imm} << 11)) >> 11)}"
  },

  JumpR : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}",
    brTarget = "($reg{$bitfield{rs1}} + $resolved{(((int16_t)($bitfield{imm} << 4)) >> 4)}) & -2U",
    imm = "$resolved{(((int16_t)($bitfield{imm} << 4)) >> 4)}"
  }
}

/***** Variants *****/
CorePerfModel RC (
  core : "RV64IMACFD"
  use Pipeline : RC_pipeline
  use ConnectorModel : {staBranchPredModel, regModel, iCacheModel}
)