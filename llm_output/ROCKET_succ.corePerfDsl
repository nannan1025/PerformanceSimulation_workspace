/***** Microaction Section *****/
Connector {Pc, Pc_np, Pc_p}
Connector {Xa, Xb, Xd}

Resource {PC_Gen, IBuf(1), CSR(2), Decoder, ALU, MUL(3), LSU(2), Reg}
Resource {DIV(divider), DIVU(divider_u)}
Resource {DPort_W(dMemModel), DPort_R(dMemModel), IPort_R(iMemModel)}
Resource {Flush(3)}

Microaction {
  uA_PCGen         (Pc -> PC_Gen -> Pc_p),
  uA_IFetch        (Pc -> IPort_R),
  uA_IBuf          (IBuf),
  uA_Decode        (Decoder),
  uA_OF_A          (Xa),
  uA_OF_B          (Xb),
  uA_ALU_arith     (ALU -> Xd),
  uA_ALU_branch    (ALU -> Pc_np),
  uA_ALU_mem       (ALU),
  uA_CSR           (CSR -> Xd),
  uA_MUL           (MUL -> Xd),
  uA_DIV           (DIV -> Xd),
  uA_DIVU          (DIVU -> Xd),
  uA_LSU           (LSU),
  uA_Memory_R      (DPort_R -> Xd),
  uA_Memory_W      (DPort_W),
  uA_RegWriteBack  (Reg),
  uA_Flush         (Flush)
}

/***** Stages & Pipeline *****/

Stage {
  PC    (uA_PCGen),
  IF    (uA_IFetch),
  ID    (uA_IBuf, uA_Decode, uA_OF_A, uA_OF_B),
  EX    (uA_ALU_arith, uA_ALU_branch, uA_ALU_mem, uA_MUL, uA_DIV, uA_DIVU, uA_CSR),
  MEM   (uA_LSU, uA_Memory_R, uA_Memory_W),
  WB    (uA_RegWriteBack, uA_Flush)
}

Pipeline ROCKET_pipeline (PC -> IF -> ID -> EX -> MEM -> WB)

/***** External Models *****/
TraceValue {rs1, rs2, rd, pc, brTarget, rs2_data}

ConnectorModel regModel (
  link : "models/common/StandardRegisterModel.h"
  trace : {rs1, rs2, rd}
  connectorIn : Xd
  connectorOut : {Xa, Xb}
)

ConnectorModel dyBranchPredModel (
  link : "models/common/DynamicBranchPredictModel.h"
  trace : {pc, brTarget}
  connectorIn : {Pc_p, Pc_np}
  connectorOut : Pc
)

ResourceModel divider (
  link: "models/cv32e40p/DividerModel.h"
  trace: rs2_data
)

ResourceModel divider_u (
  link: "models/cv32e40p/DividerUnsignedModel.h"
  trace: rs2_data
)

ResourceModel iMemModel (
    link : "models/common/DummyMemoryModel.h"
)

ResourceModel dMemModel (
    link : "models/common/DummyMemoryModel.h"
)

/***** Instruction Section *****/
InstrGroup {
  Arith_Ra_Rb (add, sub, xor, or, and, slt, sltu, sll, srl, sra, addw, subw),
  Arith_Ra (addi, xori, ori, andi, slti, sltiu, slli, srli, srai, addiw, slliw, sraiw, srliw),
  Arith_X (auipc, lui),
  Mul_Ra_Rb (mul, mulw),
  MulH_Ra_Rb (mulh, mulhu, mulhsu),
  Div_Ra_Rb (div, rem, divw, remw),
  DivU_Ra_Rb (divu, remu, divuw, remuw),
  Csr_Ra (csrrw, csrrs, csrrc, csrrwi, csrrsi, csrrci),
  Csr_X (csrrwi, csrrsi, csrrci),
  Store (sb, sh, sw, sd),
  Load (lb, lbu, lh, lhu, lw, ld, lwu),
  Branch_Ra_Rb (beq, bne, blt, bge, bltu, bgeu),
  Jump (jal),
  JumpR (jalr),
  System (fence, mret, ecall, sret),
  Default ([?])
}

MicroactionMapping {
  [ALL] :        {uA_PCGen, uA_IFetch, uA_IBuf, uA_Decode},
  Arith_Ra_Rb :  {uA_OF_A, uA_OF_B, uA_ALU_arith, uA_RegWriteBack},
  Arith_Ra :     {uA_OF_A, uA_ALU_arith, uA_RegWriteBack},
  Arith_X :      {uA_ALU_arith, uA_RegWriteBack},
  Mul_Ra_Rb :    {uA_OF_A, uA_OF_B, uA_MUL, uA_RegWriteBack},
  MulH_Ra_Rb :   {uA_OF_A, uA_OF_B, uA_MUL, uA_RegWriteBack},
  Div_Ra_Rb :    {uA_OF_A, uA_OF_B, uA_DIV, uA_RegWriteBack},
  DivU_Ra_Rb :   {uA_OF_A, uA_OF_B, uA_DIVU, uA_RegWriteBack},
  Csr_Ra :       {uA_OF_A, uA_CSR, uA_RegWriteBack, uA_Flush},
  Csr_X :        {uA_ALU_arith, uA_RegWriteBack},
  Store :        {uA_OF_A, uA_OF_B, uA_ALU_mem, uA_LSU, uA_Memory_W},
  Load :         {uA_OF_A, uA_ALU_mem, uA_LSU, uA_Memory_R, uA_RegWriteBack},
  Branch_Ra_Rb : {uA_OF_A, uA_OF_B, uA_ALU_branch},
  Jump :         {uA_ALU_arith, uA_RegWriteBack},
  JumpR :        {uA_OF_A, uA_ALU_arith, uA_RegWriteBack},
  System        : {uA_Flush}
}

TraceValueMapping {
  [ALL] : {
      pc = "$resolved{$pc}"
  },
  Arith_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },
  Arith_Ra : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },
  Arith_X : {
    rd  = "$bitfield{rd}"
  },
  Mul_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },
  MulH_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },
  Div_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  DivU_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },
  Csr_Ra : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },
  Csr_X : {
    rd  = "$bitfield{rd}"
  },
  Store : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}"
  },
  Load : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },
  Branch_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    brTarget = "$resolved{$pc + (((int16_t)($bitfield{imm} << 3)) >> 3)}"
  },
  Jump : {
    rd = "$bitfield{rd}",
    brTarget = "$resolved{$pc + (((int32_t)($bitfield{imm} << 11)) >> 11)}"
  },
  JumpR : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}",
    brTarget = "($reg{$bitfield{rs1}} + $resolved{(((int16_t)($bitfield{imm} << 4)) >> 4)}) & -2U"
  }
}

/***** Variants *****/
CorePerfModel ROCKET (
  core : "RV64IMACFD"
  use Pipeline : ROCKET_pipeline
  use ConnectorModel : {dyBranchPredModel, regModel}
)
